# AccessOS Environment Variables
# Fill in your Featherless API key below. NEVER commit this file.
FEATHERLESS_API_KEY=rc_22b315d75421c2d83e7ca3df49874e1b0c7ff8778c29db23d336914d9a411562
FEATHERLESS_MODEL=ByteDance-Seed/UI-TARS-1.5-7B
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1

# ── Optional: Multi-monitor support (L6 fix) ──────────────────────────────
# 1 = primary monitor, 2 = second monitor, etc. Default: 1
# MONITOR_INDEX=1

# ── Optional: Tesseract OCR binary path (L5 fix) ──────────────────────────
# Set this if Tesseract is not on your system PATH.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# ── Optional: Whisper offline STT model (L1 fix) ──────────────────────────
# Requires: pip install openai-whisper
# Options: tiny, base (default), small, medium, large
# Larger models are more accurate but slower and use more memory.
# WHISPER_MODEL=base
